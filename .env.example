# ─── Local development ───────────────────────────────────────────────────────
# Copy this file to `.env` and fill in values. Run with:
#   npm run dev
# The dev script loads `.env` automatically (NODE_ENV=development).
# Do NOT use `.env.production` for local dev unless you explicitly point to it.
#
# `npm start` runs the production bundle and does NOT load `.env` — use platform
# env vars in production (Cloud Run, etc.).

# ─── Database (Supabase Postgres) ──────────────────────────────────────────────
# Use the Session pooler URI (Connect → Session pooler). The direct db.<ref> host is IPv6-only
# and unreachable from Cloud Run. URL-encode special characters in the password (@ → %40).
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Optional alias:
# SUPABASE_DATABASE_URL=

# ─── Supabase Auth & Storage ───────────────────────────────────────────────────
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional server-side alias:
# SUPABASE_URL=

# ─── Gemini API (serves Gemma 4 and Gemini with one key) ──────────────────────
# Get a key at https://aistudio.google.com/apikey
# Primary name used in this project (either works; first match wins):
GEMINI_API_KEY=your-gemini-api-key
# Legacy / integration alias:
# AI_INTEGRATIONS_GEMINI_API_KEY=
# Other fallbacks (rare):
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# Optional custom endpoint:
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# GEMINI_BASE_URL=

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000
# Production only (CORS):
# FRONTEND_URL=https://your-app.example.com
# DB_POOL_SIZE=10
